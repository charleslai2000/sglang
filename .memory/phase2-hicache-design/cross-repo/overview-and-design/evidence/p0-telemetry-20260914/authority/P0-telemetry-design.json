    "option_a": "Add versioned hicache_telemetry to meta_info only when existing request file export is enabled; reuse current exporter.",
    "option_b": "Preserve response meta_info bytes; requires fresh architecture dispatch for a private exporter-only envelope.",
    "blocked_if": "Option B is mandatory inside the current bounded P0."
  },
  "invariants": [
    "Telemetry never influences RH, admission, transfer, restore, eviction, or retry.",
    "No request or attempt identity is a Prometheus label.",
    "All subtractable timestamps use time.monotonic_ns in one scheduler process.",
    "l1_tokens + l2_tokens + l3_tokens + newly_prefilled_tokens == prompt_tokens.",
    "Mamba and other sidecar units are not added to logical prompt-token tiers.",
    "avoidable_recompute_tokens is null when durable reusable coverage is unknown.",
    "0 <= avoidable_recompute_tokens <= newly_prefilled_tokens when known.",
    "A successful joined RH restore satisfies issue <= ready <= admission <= prefill_finish."
  ],
  "formulas": {
    "l3_tokens": "min(host_hit_length, storage_hit_length)",
    "l2_tokens": "host_hit_length - l3_tokens",
    "l1_tokens": "max(0, prefix_len_after_loadback - host_hit_length)",
    "newly_prefilled_tokens": "max(0, prompt_tokens - l1_tokens - l2_tokens - l3_tokens)",
    "avoidable_recompute_tokens": "max(0, min(prompt_tokens, durable_reusable_prefix_tokens) - (l1_tokens + l2_tokens + l3_tokens)); null if durable_reusable_prefix_tokens is not authoritative",
    "rh_prefetch_lead_seconds": "(admission_mono_ns - prefetch_issue_mono_ns) / 1e9",
    "rh_ready_slack_seconds": "(admission_mono_ns - ready_mono_ns) / 1e9",
    "storage_query_seconds": "(storage_query_end_mono_ns - storage_query_start_mono_ns) / 1e9",
    "prefetch_to_ready_seconds": "(ready_mono_ns - prefetch_issue_mono_ns) / 1e9",
    "ready_to_admission_seconds": "(admission_mono_ns - ready_mono_ns) / 1e9",
    "admission_to_prefill_finish_seconds": "(prefill_finish_mono_ns - admission_mono_ns) / 1e9"
  },
  "units": {
