# provider.env — single source of truth for the RTX-3090 DEV provider.
#
# This is a DEPLOYMENT-ONLY service: it runs a pinned, byte-verified git
# commit exported out of the repo into a stable deploy tree.  The repo
# worktree is never the runtime source of truth.
#
# Profile (fixed by the owner dispatch, 2026-09-17):
#   model  = M1 Qwen3.5-9B W4A16
#   port   = 30001  (DEV provider; 30000 is RESERVED for production; 301xx are RESERVED for experiments; never bound here)
#   L1 radix cache ON (default), Host/L2 HiCache ON (32 GB SI host pool)
#   L3 / extent backend OFF (no --hicache-storage-backend, no EXTENT_* env)
#   AUTH OFF -- owner ruling 2026-09-17: this is a private LAN
#   (192.168.20.0/24) and an API key is NOT required.  The launch path must
#   not pass --api-key and must not reference the key file.  A leftover
#   api-key.txt from the earlier auth experiment may remain on disk unused;
#   nothing here reads it, and its contents are never printed.
#
# Sourced by bin/provider-common.sh.  Contains NO secret material.

# ------------------------------------------------------------------ identity
PROVIDER_NAME="opencodex-provider"

REPO="/home/ubuntu/workspaces/3rdparty/sglang"
BRANCH="3090-24g-opt"

# Source of truth for the SERVED CODE.  The provider runs the exported bytes
# of exactly this commit, verified file-by-file against the git object store.
#
# History note (recorded, not hidden): the dispatch named HEAD=4abcf3e7839e.
# That object was amended away by a concurrent branch writer and is no longer
# on the branch (only the amended tip is).  Its python/ subtree is byte-
# identical to the commit pinned here, so the validated serving flags apply
# unchanged.  We pin a commit that is reachable from the branch, because an
# unreachable object can be pruned by gc and would then be unexportable.
SOURCE_COMMIT="2d4e33a832ec7e5a2f5311b86ca6a6e8a703faa7"
SOURCE_COMMIT_DISPATCH="4abcf3e7839e8843701659992eaf1c3b7623b5f6"

# Both of these are identical across every candidate commit of this branch,
# so the pin above cannot silently change the served code:
#   git rev-parse <commit>:python            == python tree
#   git rev-parse <commit>:python/sglang     == the subtree we execute
# provider-start recomputes both and refuses if either differs.
PYTHON_TREE_SHA="6b7bae01619da2124669d7977239422c80d1cdee"
PYTHON_SGLANG_TREE_SHA="f0aab07e1c2cdffc1ca3bce17e43e75fab978b6d"

# ------------------------------------------------------------------ deploy tree
DEPLOY_ROOT_DEFAULT="/opt/sglang/${PROVIDER_NAME}-$(printf '%s' 2d4e33a832ec7e5a2f5311b86ca6a6e8a703faa7 | cut -c1-10)"

# Isolated runtime dir (logs / pid / state / metrics).  Never the prod or test
# scaffold dirs; never /data/l3/local-prod-v1.1.
RUN_DIR_DEFAULT="/opt/sglang/${PROVIDER_NAME}-run"

# Untracked build outputs that `git archive` cannot carry (`.so` and
# _version.py are gitignored) but that the proven frozen tree also ships.
# They are staged into the deploy tree and digest-pinned separately so a
# later change in /opt is still detected.  None are exercised by this
# serving profile (no --grpc-port, no SGLANG_RUST_SERVER, no Inkling model);
# staging them prevents any accidental cargo build at import time.
PROVIDER_ARTIFACTS=(
  "python/sglang/_version.py"
  "python/sglang/srt/rust_extensions/_grpc.cpython-312-x86_64-linux-gnu.so"
  "python/sglang/srt/rust_extensions/_multimodal.cpython-312-x86_64-linux-gnu.so"
  "python/sglang/srt/rust_extensions/_server.cpython-312-x86_64-linux-gnu.so"
)

# ------------------------------------------------------------------ runtime
VENV_PY="/home/ubuntu/venvs/sglang-3090/bin/python"
MODEL_PATH="/data/models/qwen35-9b-w4a16"
SERVED_MODEL_NAME="qwen35-9b-local"

# Private LAN bind (192.168.20.0/24 lab network).  No public exposure.
BIND_HOST="192.168.20.250"
# Port separation: 30000=PRODUCTION, 30001=DEV provider.
# 301xx (30100-30199) remain RESERVED for experiments.
BIND_PORT=30001
RESERVED_PORT_LO=30100
RESERVED_PORT_HI=30199

# ------------------------------------------------------------------ GPU
# NVML index and CUDA ordinal are inverted on this box: never trust a bare
# index.  The CUDA ordinal is resolved from this UUID at start time, and the
# running server is then verified to actually be on this UUID.
GPU_UUID="GPU-2e3ed202-3655-d919-0a64-259209bc6587"
GPU_MIN_MATERIAL_MIB=2048

# Canonical single GPU lock.  NOT overridable from the environment.
GPU_LOCK="/tmp/opencode/gpu-3090.lock"

# ------------------------------------------------------------------ serving profile
TP_SIZE=1
MEM_FRACTION_STATIC=0.92

# ------------------------------------------------------------ 128K-C8 profile
# Retuned 2026-09-17 for the C8 business profile.  Every value below is a
# MEASURED result on this box/GPU/model, not a derived estimate:
#
#   KV cost      : 16384 bytes/token at fp8_e4m3 (8 attention layers x 4 KV
#                  heads x 256 head_dim x 2 (K,V) x 1 byte) -> 524288 tokens
#                  = 8.00 GB (K 4.00 + V 4.00), confirmed by the startup log.
#   ceiling      : the engine profiles a hard cap and silently clamps anything
#                  above it ("max_total_tokens=... is larger than the profiled
#                  value").  Measured clamp: 560525 tokens.  524288 stays below
#                  it and left 1130 MiB (4.6%) free at the measured VRAM peak.
#   mamba pool   : measured 5 state slots/request (extra_buffer share).  C8
#                  therefore needs 40 slots; 48 additionally caps
#                  max_running_requests at 48//5 = 9, i.e. >= 8 with headroom.
#                  48 slots measured 2.30 GB SSM + 0.05 GB conv state.
#   decode graph : only the C8 buckets are captured.  Measured: sizes 2,3,4,5,
#                  6,7,8 all occur and are padded up to the next captured
#                  bucket, and every decode pass stayed on the graph
#                  (decode_none == 0).
#
# Per-request context cap and the total GPU KV budget are different knobs:
# context_length caps ONE request (131072); max_total_tokens is the shared
# budget for all active requests (e.g. 1x128K or 4x128K is below 524288).
CONTEXT_LENGTH=131072
MAX_RUNNING_REQUESTS=8
MAX_TOTAL_TOKENS=524288
MAX_MAMBA_CACHE_SIZE=48
# Decode CUDA-graph batch sizes, covering the C8 ceiling only.
CUDA_GRAPH_BS_DECODE="1 2 4 8"

KV_CACHE_DTYPE="fp8_e4m3"
ATTENTION_BACKEND="flashinfer"
LINEAR_ATTN_PREFILL_BACKEND="triton"
LINEAR_ATTN_DECODE_BACKEND="triton"
MAMBA_RADIX_CACHE_STRATEGY="extra_buffer"
MAMBA_SSM_DTYPE="float32"
HICACHE_WRITE_POLICY="write_back"

# --hicache-size is SI GB (10^9), NOT GiB.  32 SI GB == 29.8 GiB.
# Host RAM on this box: 125 GiB total, ~120 GiB available.
L2_GB=32

REASONING_PARSER="qwen3"
TOOL_CALL_PARSER="qwen3_coder"

# ------------------------------------------------------------------ timeouts (s)
# Recorded cold start for this model/profile on this box: ~79 s
# (launcher -> /health 200).  The bound is generous, and an early process
# death aborts long before it.
START_TIMEOUT_S=900
HEALTH_TIMEOUT_S=900
STOP_TIMEOUT_S=300
LOCK_WAIT_S=60
SMOKE_TIMEOUT_S=300

# ------------------------------------------------------------------ L3 / extent
# Hard OFF.  These are explicitly unset in the launch environment regardless
# of what the caller's shell contains, and provider-start also refuses to run
# if any of them are set in its own environment.
L3_FORBIDDEN_ENV="SGLANG_HICACHE_EXTENT_BACKEND_STORAGE_DIR SGLANG_HICACHE_EXTENT_BACKEND_MAX_SIZE SGLANG_HICACHE_EXTENT_BACKEND_MIN_FREE_SPACE SGLANG_HICACHE_EXTENT_BACKEND_EXTENT_SIZE SGLANG_HICACHE_EXTENT_BACKEND_FILE_SIZE SGLANG_HICACHE_EXTENT_BACKEND_WAL_CHECKPOINT_BYTES SGLANG_HICACHE_EXTENT_BACKEND_DIRECT_IO SGLANG_L3_BACKEND SGLANG_L3_NATIVE_WRITE_PATH"
