+def evaluate_verdict(art, require_vision):
+    """Fail-closed per-model verdict.
+
+    PASS only when every required gate/probe actually executed and passed.
+    Missing evidence is a failure, never the absence of a failure.  The
+    answer-quality fields (``contains_expected``) are deliberately NOT gated
+    here: that would change model-evaluation semantics.  This verdict certifies
+    execution + structural gates.
+    """
+    failures = []
+    if art.get("status") != "completed":
+        failures.append(f"status={art.get('status')!r} is not 'completed'")
+    if not art.get("kv_gate", {}).get("ok"):
+        failures.append("kv_gate not passed")
+    fl = art.get("step1_finite_logits")
+    if not isinstance(fl, dict) or not fl:
+        failures.append("finite_logits missing")
+    else:
+        for tag, rec in fl.items():
+            if not isinstance(rec, dict) or rec.get("http") != 200:
+                failures.append(f"finite_logits[{tag}] not executed (http!=200)")
+            elif rec.get("n_logprob_values_checked", 0) <= 0:
+                failures.append(f"finite_logits[{tag}] no logprob values")
+            elif rec.get("n_nonfinite") != 0:
+                failures.append(f"finite_logits[{tag}] n_nonfinite={rec.get('n_nonfinite')}")
+    sem = art.get("step2_semantic")
+    if not isinstance(sem, dict) or not sem:
+        failures.append("semantic_probe missing")
+    else:
+        for tag, rec in sem.items():
+            if not isinstance(rec, dict) or rec.get("http") != 200:
+                failures.append(f"semantic[{tag}] not executed (http!=200)")
+    if require_vision:
+        vis = art.get("step2_vision")
+        if not isinstance(vis, dict) or not vis:
+            failures.append("vision_probe missing")
+        else:
+            for tag in ("color", "shape"):
+                rec = vis.get(tag)
+                if not isinstance(rec, dict) or rec.get("http") != 200:
+                    failures.append(f"vision[{tag}] not executed (http!=200)")
+    if art.get("step_exception"):
+        failures.append("step_exception present")
+    return ("PASS" if not failures else "FAIL"), failures
+
+
+def verdict_exit_code(verdict):
+    return 0 if verdict == "PASS" else 5
+
+
+def finish(outdir, art, rc, require_vision):
+    """Attach the verdict, write the artifact, and return the process exit code."""
+    verdict, failures = evaluate_verdict(art, require_vision)
+    art["verdict"] = verdict
+    art["verdict_failures"] = failures
+    art.setdefault("finished_utc", now())
+    write_art(outdir, art)
+    if verdict != "PASS":
+        return rc if rc else verdict_exit_code(verdict)
+    return 0
+
+
