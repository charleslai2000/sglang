+# llama.cpp writes Gemma-style (offset) norms to GGUF as the *absolute* scale
+# ``1 + w_hf``.  ``GemmaRMSNorm`` applies ``x * (1 + weight)`` (and precomputes
+# ``weight + 1``), so the loader must strip the embedded ``+1`` or every such
+# norm is applied twice.  ``linear_attn.norm`` is a plain ``RMSNormGated`` and
+# must NOT be adjusted.
+_GGUF_OFFSET_NORM_SUFFIXES = (
+    ".input_layernorm.weight",
+    ".post_attention_layernorm.weight",
+    ".q_norm.weight",
+    ".k_norm.weight",
+)
+
+
+def _gguf_is_offset_norm(name: str) -> bool:
+    """True for a GGUF weight naming a Gemma-style (offset) norm."""
+    if name.endswith(".linear_attn.norm.weight"):
+        return False
+    return name == "model.norm.weight" or name.endswith(_GGUF_OFFSET_NORM_SUFFIXES)
+
