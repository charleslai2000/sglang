#!/bin/bash
# @@IDENTITY@@ — canonical launcher (built by bin/launcher-repin.sh)
# Frozen tree:   @@TREE@@
# Frozen identity: @@TREE@@/manifest/IDENTITY.md
# Frozen pins:     @@TREE@@/manifest/identity.json
# Profile: SGLANG_PROFILE=perf|capacity   (default perf)
#
# ---------------------------------------------------------------------------
# FAIL-CLOSED SOURCE-IDENTITY GATE — runs BEFORE anything is executed.
# A stale/byte-copied launcher (the v1 -> v1.1 failure mode) cannot pass it:
#   * sglang.__file__ must resolve under @@TREE@@/src/python (not the venv
#     editable binding, which points at the live WIP workspace);
#   * every file hash must match @@TREE@@/manifest/TREE-SHA256.txt and the
#     manifest's own digest must match identity.json;
#   * the src-subtree stream digest must equal EXPECTED_SRC_STREAM_SHA256,
#     which is baked into this file and does not depend on the launcher bytes;
#   * /proc/self/environ must show PYTHONPATH=@@TREE@@/src/python;
#   * the L3 store namespace must be unique to SGLANG_RUN_ID.
# The gate imports sglang in a CPU-only child (CUDA_VISIBLE_DEVICES=999) and
# never starts a server or binds a port.  Cost: one full tree hash (~7 s) plus
# one import (~10 s).  There is no skip switch, by design.
# ---------------------------------------------------------------------------
set -euo pipefail

MODEL_PATH="${SGLANG_MODEL_PATH:-/data/models/omnicoder-9b-gptq-int4}"

PROFILE="${SGLANG_PROFILE:-perf}"
PORT="${SGLANG_PORT:-30000}"

# --- frozen src-subtree stream digest (v1 convention; independent of this file) ---
EXPECTED_SRC_STREAM_SHA256="@@SRC_STREAM_SHA256@@"

# --- L3/HiCache mode: M2 serves with the HiCache HOST tier ON but with NO L3
# storage backend.  "disabled" is the ONLY accepted value and there is NO
# default, so the choice can never be made silently. ---
: "${SGLANG_L3_MODE:?FATAL: SGLANG_L3_MODE must be set explicitly to 'disabled' for M2 (no default)}"
if [ "$SGLANG_L3_MODE" != "disabled" ]; then
  echo "FATAL: M2 requires SGLANG_L3_MODE=disabled, got '$SGLANG_L3_MODE'" >&2
  exit 2
fi

# --- per-run L3 namespace: one task/run -> one unique store ---------------
# A shared store is NEVER used or cleared by a run: clearing unlinks the
# previous task's WAL segment and destroys concurrent durability evidence.
: "${SGLANG_RUN_ID:?FATAL: SGLANG_RUN_ID must be set; one task/run -> one unique L3 store namespace (e.g. run-20260917T0130Z-<task>)}"
case "$SGLANG_RUN_ID" in
  local-prod-* | shared | default | common | prod | production | l3 | data)
    echo "FATAL: refusing reserved/shared L3 namespace SGLANG_RUN_ID=$SGLANG_RUN_ID" >&2
    exit 4 ;;
esac
case "$SGLANG_RUN_ID" in
  *[!A-Za-z0-9._-]* | *..* | .* | -*)
    echo "FATAL: SGLANG_RUN_ID must match [A-Za-z0-9][A-Za-z0-9._-]* : $SGLANG_RUN_ID" >&2
    exit 4 ;;
esac

# --- pinned cache budgets. Physical capacity != benchmark cache budget. ---
# NOTE: --hicache-size is SI GB (10^9), NOT GiB.
case "$PROFILE" in
  perf)     L2_GB=32; L3_MAX=100Gi ;;   # L2 = 32 GB = 29.8 GiB
  capacity) L2_GB=48; L3_MAX=200Gi ;;   # L2 = 48 GB = 44.7 GiB
  *) echo "FATAL: unknown SGLANG_PROFILE=$PROFILE (want perf|capacity)" >&2; exit 2 ;;
esac

TREE="@@TREE@@"
SRC="$TREE/src"
PY="$TREE/env/bin/python"
IDENTITY="@@IDENTITY@@"

# L3_ROOT/L3_DIR exist ONLY for the disabled-mode negative assertion in GATE 3/3.
L3_ROOT="${SGLANG_L3_ROOT:-/data/l3}"
L3_DIR="$L3_ROOT/$SGLANG_RUN_ID"

# Per-run log dir so that a run can never overwrite a previous run's metrics
# evidence.  Overridable for dry-runs.
LOG_DIR="${SGLANG_LOG_DIR:-/var/log/sglang/@@TREE_NAME@@/$SGLANG_RUN_ID}"

# --- source binding: MUST be the frozen snapshot, NOT the editable venv path ---
export PYTHONPATH="$SRC/python"

# --- CUDA ---
export CUDA_HOME=/usr/local/cuda-12.9
export PATH="$CUDA_HOME/bin:$PATH"

# --- GPU pin: UUID only (NVML index and CUDA ordinal are INVERTED on this box) ---
export CUDA_VISIBLE_DEVICES=GPU-2e3ed202-3655-d919-0a64-259209bc6587

# --- L3/HiCache storage disabled: explicitly strip any inherited extent/L3
#     state so it can never reach the server, and report it rather than
#     silently cleaning. ---
STRIPPED=""
for leak in SGLANG_HICACHE_EXTENT_BACKEND_STORAGE_DIR \
            SGLANG_HICACHE_EXTENT_BACKEND_MAX_SIZE \
            SGLANG_HICACHE_EXTENT_BACKEND_MIN_FREE_SPACE \
            SGLANG_L3_NATIVE_WRITE_PATH \
            SGLANG_L3_BACKEND; do
  if printenv "$leak" >/dev/null 2>&1; then
    STRIPPED="$STRIPPED $leak=$(printenv "$leak")"
  fi
done
unset SGLANG_HICACHE_EXTENT_BACKEND_STORAGE_DIR
unset SGLANG_HICACHE_EXTENT_BACKEND_MAX_SIZE
unset SGLANG_HICACHE_EXTENT_BACKEND_MIN_FREE_SPACE
unset SGLANG_L3_NATIVE_WRITE_PATH
unset SGLANG_L3_BACKEND
if [ -n "$STRIPPED" ]; then
  echo "NOTE: stripped inherited L3/HiCache env while disabled:$STRIPPED" >&2
fi

echo "=== $IDENTITY launcher ==="
echo "tree=$TREE"
echo "profile=$PROFILE port=$PORT hicache-size=${L2_GB}GB(SI) L3_MAX=$L3_MAX"
echo "PYTHONPATH=$PYTHONPATH"
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
echo "SGLANG_RUN_ID=$SGLANG_RUN_ID"
echo "L3_DIR=$L3_DIR"
echo "LOG_DIR=$LOG_DIR"
echo "=============================="

# ---------------------------------------------------------------------------
# GATE 1/3 — source identity: resolve + full manifest + /proc environ.
# ---------------------------------------------------------------------------
GATE_RC=0
GATE_OUT="$(env CUDA_VISIBLE_DEVICES=999 PYTHONDONTWRITEBYTECODE=1 \
  "$PY" "$TREE/tools/preflight_identity.py" \
  --tree "$TREE" --pid self --all --json 2>&1)" || GATE_RC=$?
if [ "$GATE_RC" -ne 0 ]; then
  echo "FATAL: source-identity gate FAILED (exit $GATE_RC) for tree $TREE" >&2
  echo "$GATE_OUT" >&2
  exit "$GATE_RC"
fi

# ---------------------------------------------------------------------------
# GATE 2/3 — frozen src-subtree stream digest (rule out a stale launcher that
# points at a different tree with a valid-looking path).
# ---------------------------------------------------------------------------
STREAM_SHA="$( cd "$SRC" && find . -type f \
    -not -path '*/__pycache__/*' -not -path '*/.pytest_cache/*' -print0 \
    | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1 )"
if [ "$STREAM_SHA" != "$EXPECTED_SRC_STREAM_SHA256" ]; then
  echo "FATAL: src stream digest mismatch" >&2
  echo "  expected $EXPECTED_SRC_STREAM_SHA256" >&2
  echo "  actual   $STREAM_SHA" >&2
  exit 12
fi

# ---------------------------------------------------------------------------
# Serving argv.  The dry-run prints exactly this array; the real path execs
# exactly this array, so the dry-run cannot diverge from the launch.
# M2: HiCache HOST (L2) tier ON with the X-f-proven trio plus the explicit
# host-memory-mode pin; no L3 storage backend.  Values pinned from the MEASURED
# 128K/C8 profile; every value is measured on this box/GPU/model, not derived.
# ---------------------------------------------------------------------------
ARGS=(
  -m sglang.launch_server
  --model-path "$MODEL_PATH"
  --host 0.0.0.0 --port "$PORT" \
  --tp-size 1
  --mem-fraction-static 0.92
  --max-total-tokens 262144
  --context-length 131072
  --max-running-requests 8
  --max-mamba-cache-size 48
  --kv-cache-dtype fp8_e4m3
  --attention-backend flashinfer
  --linear-attn-prefill-backend triton
  --linear-attn-decode-backend triton
  --mamba-radix-cache-strategy extra_buffer
  --mamba-ssm-dtype float32
  --enable-hierarchical-cache
  --hicache-write-policy write_back
  --hicache-size 32
  --hicache-host-memory-mode cache
  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder
  --enable-metrics
  --export-metrics-to-file
  --export-metrics-to-file-dir "$LOG_DIR"
  --disable-prefill-cuda-graph
)

# ---------------------------------------------------------------------------
# GATE 3/3 — L3/HiCache state.  M2 has no L3 store, so this gate does NOT
# allocate or validate a namespace for use; it invokes the tree's own policy
# tool to prove the store for this run does NOT exist and never fabricates a
# namespace PASS.  It is a positive, fail-closed assertion:
#   (a) SGLANG_L3_MODE == disabled (enforced above);
#   (b) l3_namespace.py --validate MUST refuse with exit 6 (no store claimed);
#       exit 0 would mean a store is allocated -> L3 is silently in use -> FAIL;
#   (c) after the explicit strip above, no extent/L3 env variable may remain
#       (post-condition; a nonzero exiting printenv check would be a bug);
#   (d) the HiCache host tier is ON and pinned: exactly one
#       --enable-hierarchical-cache, and --hicache-write-policy/--hicache-size/
#       --hicache-host-memory-mode at most once each and immediately followed by
#       write_back/32/cache; every L3 storage/derived-layout token remains
#       forbidden.
# ---------------------------------------------------------------------------
NS_RC=0
NS_OUT="$(env PYTHONDONTWRITEBYTECODE=1 "$PY" "$TREE/tools/l3_namespace.py" \
  --validate --task-id "$SGLANG_RUN_ID" --root "$L3_ROOT" \
  --path "$L3_DIR" --json 2>&1)" || NS_RC=$?
if [ "$NS_RC" -eq 0 ]; then
  echo "FATAL: L3 store $L3_DIR is allocated while SGLANG_L3_MODE=disabled" >&2
  echo "$NS_OUT" >&2
  exit 14
fi
if [ "$NS_RC" -ne 6 ]; then
  echo "FATAL: L3-disabled gate expected refusal (exit 6), got $NS_RC for $L3_DIR" >&2
  echo "$NS_OUT" >&2
  exit "$NS_RC"
fi
for leak in SGLANG_HICACHE_EXTENT_BACKEND_STORAGE_DIR \
            SGLANG_HICACHE_EXTENT_BACKEND_MAX_SIZE \
            SGLANG_HICACHE_EXTENT_BACKEND_MIN_FREE_SPACE \
            SGLANG_L3_NATIVE_WRITE_PATH \
            SGLANG_L3_BACKEND; do
  if printenv "$leak" >/dev/null 2>&1; then
    echo "FATAL: L3/HiCache env still present after strip while disabled: $leak=$(printenv "$leak")" >&2
    exit 13
  fi
done

# Positive HiCache host-tier pinning (replaces the blanket HiCache ban): the
# host tier is ON, so assert the exact switches and values, and still forbid
# every L3-storage/derived-layout token and any duplicate HiCache flag.
arg_count() {
  local needle="$1" n=0 a
  for a in "${ARGS[@]}"; do
    if [ "$a" = "$needle" ]; then n=$((n + 1)); fi
  done
  printf '%s' "$n"
}
arg_value_after() {
  local needle="$1" i
  for ((i = 0; i < ${#ARGS[@]}; i++)); do
    if [ "${ARGS[i]}" = "$needle" ]; then
      printf '%s' "${ARGS[i + 1]:-}"
      return 0
    fi
  done
  printf ''
}
for pinned in --enable-hierarchical-cache --hicache-write-policy \
              --hicache-size --hicache-host-memory-mode; do
  if [ "$(arg_count "$pinned")" -ne 1 ]; then
    echo "FATAL: HiCache flag must appear exactly once in ARGS: $pinned (found $(arg_count "$pinned"))" >&2
    exit 13
  fi
done
if [ "$(arg_value_after --hicache-write-policy)" != "write_back" ]; then
  echo "FATAL: --hicache-write-policy must be followed by write_back" >&2
  exit 13
fi
if [ "$(arg_value_after --hicache-size)" != "32" ]; then
  echo "FATAL: --hicache-size must be followed by 32" >&2
  exit 13
fi
if [ "$(arg_value_after --hicache-host-memory-mode)" != "cache" ]; then
  echo "FATAL: --hicache-host-memory-mode must be followed by cache" >&2
  exit 13
fi
for forbidden in --hicache-storage-backend --hicache-storage-prefetch-policy \
                 --enable-ready-horizon --hicache-ratio --hicache-io-backend \
                 --hicache-mem-layout; do
  for arg in "${ARGS[@]}"; do
    if [ "$arg" = "$forbidden" ]; then
      echo "FATAL: forbidden L3/HiCache token present while storage is disabled: $forbidden" >&2
      exit 13
    fi
  done
done
echo "L3 GATE: storage backend DISABLED (SGLANG_L3_MODE=$SGLANG_L3_MODE; no store allocated; no extent env; HiCache host tier pinned)"

# Dry-run: gates 1-3 already ran, nothing has been created or bound yet.
# Prints the exact argv that would be exec'd; exits without starting anything.
if [ "${SGLANG_LAUNCH_DRY_RUN:-0}" = "1" ]; then
  printf 'DRY-RUN OK identity=%s tree=%s run_id=%s l3=%s\n' \
    "$IDENTITY" "$TREE" "$SGLANG_RUN_ID" "$L3_DIR"
  printf 'DRY-RUN src_stream_sha256=%s\n' "$STREAM_SHA"
  printf 'DRY-RUN LOG_DIR=%s\n' "$LOG_DIR"
  printf 'DRY-RUN argv:'
  printf ' %q' "$PY" -u "${ARGS[@]}"
  printf '\n'
  exit 0
fi

mkdir -p "$LOG_DIR"

cd /tmp   # avoid the /home/ubuntu cwd-shadowing trap for `import sglang`
exec "$PY" -u "${ARGS[@]}"
