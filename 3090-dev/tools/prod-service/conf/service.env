# service.env — single source of truth for the prod/test service scaffold.
# Sourced by every script under bin/.  Nothing here starts a server by itself.
#
# Ports (fixed by owner directive, 2026-09-17):
#   30000  PRODUCTION  (launcher default SGLANG_PORT)
#   30164  TEST        (diagnostic)
#   30165  GATE HARNESS (reserved; never used by these scripts)
#
# Trees are selectable so either frozen identity can be driven.  The launcher
# itself is parameterised only through SGLANG_PORT / SGLANG_PROFILE /
# SGLANG_RUN_ID / SGLANG_L3_ROOT / SGLANG_LOG_DIR; the tree path is baked into
# the launcher and verified by its own fail-closed identity gate.

# ---------------------------------------------------------------- ports
PROD_PORT=30000
TEST_PORT=30164
GATE_PORT=30165

# ---------------------------------------------------------------- trees
# Only identities with a launcher that enforces the source-identity gate are
# selectable.  LOCAL-PROD-v1 and v1.1 launchers have NO gate; they are listed
# for completeness and will be refused by preflight (see bin/00-preflight.sh).
PROD_TREE_DEFAULT=/opt/sglang/local-prod-v1.2.1-candidate
PROD_IDENTITY_DEFAULT=LOCAL-PROD-v1.2.1
PROD_TREE_V121=/opt/sglang/local-prod-v1.2.1-candidate
PROD_IDENTITY_V121=LOCAL-PROD-v1.2.1
PROD_TREE_V12=/opt/sglang/local-prod-v1.2-candidate
PROD_IDENTITY_V12=LOCAL-PROD-v1.2
PROD_TREE_V1=/opt/sglang/local-prod-v1
PROD_IDENTITY_V1=LOCAL-PROD-BASELINE-v1
PROD_TREE_V11=/opt/sglang/local-prod-v1.1-candidate
PROD_IDENTITY_V11=LOCAL-PROD-v1.1
PROD_TREE_V112=/opt/sglang/local-prod-v1.1.2-candidate
PROD_IDENTITY_V112=LOCAL-PROD-v1.1.2

# TEST service always runs the frozen candidate tree.  It is NOT a different
# code lineage from production: it is the same frozen bytes on a different
# port + namespace, so a test run can never contaminate production evidence.
TEST_TREE_DEFAULT=/opt/sglang/local-prod-v1.1.2-candidate

# ---------------------------------------------------------------- M2 (OmniCoder-9B GPTQ-INT4)
# M2 runs from its own frozen envelope so that its launcher/identity can be
# pinned independently, but that envelope SHARES the M1 runtime source
# (hardlinked, no forked bytes).  M2 is a no-L3 model: M2_L3_MODE=disabled is
# mandatory and the M2 launcher has no default for it.
# M2 and prod both bind :30000 and are mutually exclusive on the single 3090.
M2_PORT=30000
M2_TREE_DEFAULT=/opt/sglang/local-prod-v1.2.1-candidate-M2
M2_IDENTITY_DEFAULT=LOCAL-PROD-v1.2.1-M2
M2_MODEL_PATH=/data/models/omnicoder-9b-gptq-int4
M2_L3_MODE=disabled

# ---------------------------------------------------------------- M3/M4 (GGUF 27B, worktree source)
# M3/M4 与 M2 互斥占用 :30000。它们运行在工作树源上（见 D2 option c）：
# envelope 的 src 是指向 repo 的符号链接；env 复用共享 venv。
# 注意：M3/M4 不冻结、不声称字节级 production identity；在 D8 的冻结裁决前，
# identity 仅用于脚手架状态记录与 stop 的身份匹配。
M3_PORT=30000
M3_TREE_DEFAULT=/opt/sglang/local-prod-m3m4-20260918/M3
M3_IDENTITY_DEFAULT=LOCAL-PROD-M3-WT-20260918
M3_MODEL_PATH=/data/models/Qwen3.8-27B-GSQ-RCO-IQ3_S.gguf
M3_MAX_TOTAL_TOKENS=16384
M4_PORT=30000
M4_TREE_DEFAULT=/opt/sglang/local-prod-m3m4-20260918/M4
M4_IDENTITY_DEFAULT=LOCAL-PROD-M4-WT-20260918
M4_MODEL_PATH=/data/models/swift-qwen38-27b-q3_k_m/Swift-Qwen3.8-27B-Q3_K_M.gguf
M4_MAX_TOTAL_TOKENS=8192
# 工作树源与其固定版本（D2 option c 的钉扎）
M3M4_SRC_DEFAULT=/home/ubuntu/workspaces/3rdparty/sglang
M3M4_SRC_PIN_COMMIT=83c70f75199849ce0fee426b1335026156dd68fb
M3M4_SRC_PIN_GGUF_NATIVE_SHA=0f3c8fb9f2e6c3eb2bdcf0a3640f26880a88179bb0b4a3f41674fbfaf8202ade

# ---------------------------------------------------------------- GPU
# NVML index and CUDA ordinal are INVERTED on this box: always pin by UUID.
GPU_UUID=GPU-2e3ed202-3655-d919-0a64-259209bc6587
CUDA_HOME=/usr/local/cuda-12.9

# Canonical single lock for this physical GPU.  Independent of task identity.
# Deliberately NOT overridable from the environment: a caller that could
# redirect this path would silently break mutual exclusion (the exact failure
# mode recorded in GPU-LOCK-COORDINATION-RULE-20260916.md).
GPU_LOCK=/tmp/opencode/gpu-3090.lock
# How long a start path may wait for the incumbent to release, in seconds.
GPU_LOCK_TIMEOUT_S=900
GPU_LOCK_POLL_S=10

# ---------------------------------------------------------------- state
SCAFFOLD_ROOT=/tmp/opencode/prod-service-20260917
STATE_FILE="$SCAFFOLD_ROOT/state/gpu-owner.json"
STATE_LOCK="$SCAFFOLD_ROOT/state/gpu-owner.lock"
PID_DIR="$SCAFFOLD_ROOT/state/pids"
RUN_DIR="$SCAFFOLD_ROOT/state/runs"

# ---------------------------------------------------------------- L3
# Frozen policy: one task/run -> one unique namespace.  The shared production
# store /data/l3/local-prod-v1.1 must never be used or cleared by a run.
L3_ROOT=/data/l3
RESERVED_L3_STORE=/data/l3/local-prod-v1.1

# ---------------------------------------------------------------- logs
LOG_ROOT="$SCAFFOLD_ROOT/logs"

# ---------------------------------------------------------------- model
MODEL_PATH=/data/models/qwen35-9b-w4a16

export PROD_PORT TEST_PORT GATE_PORT GPU_UUID CUDA_HOME GPU_LOCK \
       GPU_LOCK_TIMEOUT_S GPU_LOCK_POLL_S SCAFFOLD_ROOT STATE_FILE STATE_LOCK \
       PID_DIR RUN_DIR L3_ROOT RESERVED_L3_STORE LOG_ROOT MODEL_PATH \
       PROD_TREE_DEFAULT PROD_IDENTITY_DEFAULT TEST_TREE_DEFAULT \
       M2_PORT M2_TREE_DEFAULT M2_IDENTITY_DEFAULT M2_MODEL_PATH M2_L3_MODE \
       M3_PORT M3_TREE_DEFAULT M3_IDENTITY_DEFAULT M3_MODEL_PATH M3_MAX_TOTAL_TOKENS \
       M4_PORT M4_TREE_DEFAULT M4_IDENTITY_DEFAULT M4_MODEL_PATH M4_MAX_TOTAL_TOKENS \
       M3M4_SRC_DEFAULT M3M4_SRC_PIN_COMMIT M3M4_SRC_PIN_GGUF_NATIVE_SHA
