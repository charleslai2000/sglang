[Unit]
Description=Canonical SGLang Swift-Qwen3.8-27B Q3_K_M service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/tmp
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/workspaces/3rdparty/sglang/tools/swift-service/bin/swift-server
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
KillSignal=SIGTERM
KillMode=mixed

[Install]
WantedBy=multi-user.target
